# ---------------------------------------------------------------
# CampusCare AI — environment variables
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit your real .env file. These are placeholders only.
# ---------------------------------------------------------------

# --- Server ---
NODE_ENV=development
# Port for the Express API (the React dev server proxies /api here)
API_PORT=4000
# The URL the React app runs on (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- Database (used from Milestone 1) ---
MONGODB_URI=mongodb://127.0.0.1:27017/campuscare

# --- Authentication (used from Milestone 2) ---
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- AI (optional, used from Milestone 4) ---
# Leave empty to use the built-in rule-based fallback classifier.
# Get a free key at https://aistudio.google.com/apikey . It stays on the server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# How long to wait for Gemini before falling back to the keyword classifier (ms)
AI_TIMEOUT_MS=12000

# --- Uploads (used from Milestone 3) ---
MAX_UPLOAD_MB=5

# --- Email notifications (optional, used from Milestone 8) ---
# Leave SMTP_HOST empty to disable email. In-app notifications always work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CampusCare AI <no-reply@example.com>"
